# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
*.user
*.suo
*.userprefs

# Rider / VS / VS Code
.idea/
.vs/
.vscode/
!.vscode/extensions.json

# The fixture vaults are identified by their marker files, and one flavour's marker is a
# .vscode directory. Ignoring it left the foam vault undetectable in a fresh clone, which
# only CI could see.
!tests/fixtures/vaults/**/.vscode/
!tests/fixtures/vaults/**/.vscode/**

# Test / coverage
TestResults/
coverage/
*.coverage
*.trx

# NuGet
*.nupkg
packages/
!packages/build/

# Detangle sidecar (never commit a vault cache)
.detangle/

# Website build output
site/_out/
site/**/*.wasm.br

# OS
.DS_Store
Thumbs.db
desktop.ini

# Scratch screenshots and manual-testing artefacts.
testing/

# Claude Code worktrees and local agent state.
.claude/

# Decompiled third-party assemblies. Reading Svg.Skia's own source is how the mechanism
# behind issue #1 was found, and the decompilation is worth keeping locally while that is
# still open — but it is 6.1 MB of somebody else's code under somebody else's licence, and
# committing it would be both a licensing problem and a diff nobody can review. Regenerate
# it with ilspycmd against the resolved package rather than checking it in.
tools/decomp/

# Scratch probes written while issue #1 was being bisected. They hard-code local package
# paths and exist to be rewritten, not maintained; the findings they produced live in
# tools/repro/ and in SvgTextSelfTest, which are committed. Kept out of the tree so
# "git add -A" cannot drag four throwaway Program files into a review.
tools/shimprobe/
