<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Not invariant: in globalization-invariant mode String.Normalize is a no-op, and
      Unicode NFC folding is load-bearing for the resolver. macOS writes filenames in
      NFD, so a link typed as NFC would never match its own file (plan.md section 3.2).
      ICU is the price of that edge case being handled at all.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!--
    Compiled bindings are mandatory, not a preference: reflection-based bindings
    are what break Avalonia under trimming and Native AOT, and they fail silently
    at runtime (blank windows) rather than at build time. See plan.md section 11.
  -->
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Detangle</Product>
    <Company>Detangle</Company>
    <Authors>Don Steele</Authors>
    <Copyright>Copyright (c) 2026 Don Steele</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/donaldsteele/detangle</RepositoryUrl>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
