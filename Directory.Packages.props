<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Versions verified against nuget.org on 2026-08-20 and matched to plan.md section 11.
    Anything added here must have a stated reason in the plan; anything rejected there
    (Markdown.Avalonia, Lucene.Net, ColorCode, CefGlue, Naiad) must not reappear.
  -->
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
  </ItemGroup>

  <!--
    The WASM demo (phase 9). Avalonia.Browser brings an older SkiaSharp WebAssembly
    build than the managed SkiaSharp everything else resolves to, and the mismatch is a
    link-time failure with an undefined native symbol rather than anything a compiler
    catches — so the native asset is pinned to match the managed library on purpose.
  -->
  <ItemGroup Label="WASM demo (phase 9)">
    <PackageVersion Include="Avalonia.Browser" Version="12.1.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Parsing and rendering (phases 1-3)">
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="Mermaider" Version="0.12.2" />
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <!--
    Export (phase 7). Both already arrive transitively through Svg.Controls.Skia.Avalonia;
    they are pinned here because the PDF writer uses them directly, and a dependency you
    call by name should not be one you inherited by accident. Skia is what makes a PDF
    possible without adding a PDF library: SKDocument.CreatePdf draws the same primitives
    the screen does, and Svg.Skia replays a rendered diagram into it as vectors rather
    than as a screenshot.
  -->
  <ItemGroup Label="Export (phase 7)">
    <PackageVersion Include="SkiaSharp" Version="4.148.0" />
    <PackageVersion Include="Svg.Skia" Version="5.2.1" />
  </ItemGroup>

  <ItemGroup Label="Search (phase 5)">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!--
    Packaging and update (phase 8). Velopack does installers, deltas and the in-app
    updater for all three desktop platforms with one tool, which is why plan.md section 11
    picked it over Avalonia Parcel — whose CLI, the part CI needs, is paid.
  -->
  <ItemGroup Label="Packaging (phase 8)">
    <PackageVersion Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
  </ItemGroup>

</Project>
