<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Detangle.App.DetangleApp"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Detangle.App/Theme.axaml" />
        <ResourceInclude Source="avares://Detangle.App/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- The reader's own control surface, applied over Fluent. -->
    <StyleInclude Source="avares://Detangle.App/Controls.axaml" />

    <!-- The split editor's control template. AvaloniaEdit ships its own theme; without
         this include the editor renders as an unstyled blank area. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>

</Application>
