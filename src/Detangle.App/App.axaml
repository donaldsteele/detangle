<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Detangle.App.DetangleApp"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme />

    <!-- The split editor's control template. AvaloniaEdit ships its own theme; without
         this include the editor renders as an unstyled blank area. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </Application.Styles>

</Application>
