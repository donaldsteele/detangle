<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Icons as path data rather than a font or an image set: the application ships one
    self-contained binary and makes no network calls, and an icon pack would be a
    dependency that can go missing. Every glyph is drawn on a 24x24 grid so they line up
    at any size.

    They are deliberately plain outlines. The only place this interface is allowed to be
    colourful is the link ledger, where colour means something.
  -->

  <StreamGeometry x:Key="IconBack">M15 5 L8 12 L15 19</StreamGeometry>

  <!--
    The two side panels. A pane with one edge banded, so which panel the button controls is
    read from the icon rather than from the tooltip. Mirrored rather than redrawn, so the
    pair cannot drift apart.
  -->
  <StreamGeometry x:Key="IconPanelLeft">M4 5 H20 A1 1 0 0 1 21 6 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 V6 A1 1 0 0 1 4 5 Z M9 5 V19</StreamGeometry>
  <StreamGeometry x:Key="IconPanelRight">M4 5 H20 A1 1 0 0 1 21 6 V18 A1 1 0 0 1 20 19 H4 A1 1 0 0 1 3 18 V6 A1 1 0 0 1 4 5 Z M15 5 V19</StreamGeometry>
  <StreamGeometry x:Key="IconForward">M9 5 L16 12 L9 19</StreamGeometry>

  <!-- Files: a folder, opened. -->
  <StreamGeometry x:Key="IconFiles">M3 7 A1 1 0 0 1 4 6 H9 L11 8 H19 A1 1 0 0 1 20 9 V18 A1 1 0 0 1 19 19 H4 A1 1 0 0 1 3 18 Z</StreamGeometry>

  <!-- Search: the usual lens, because inventing a new one helps nobody. -->
  <StreamGeometry x:Key="IconSearch">M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M16 16 L20 20</StreamGeometry>

  <!-- Doctor: a pulse trace. A broken link is a symptom, and this panel is the chart. -->
  <StreamGeometry x:Key="IconDoctor">M3 12 H7 L9.5 6 L14 18 L16.5 12 H21</StreamGeometry>

  <!-- Tags: a label with its eyelet. -->
  <StreamGeometry x:Key="IconTags">M4 4 H12 L20 12 L12 20 L4 12 Z M8 8 A0.9 0.9 0 1 0 8 8.1 Z</StreamGeometry>

  <!-- Outline: heading levels, stepped. -->
  <StreamGeometry x:Key="IconOutline">M4 6 H20 M7 12 H20 M10 18 H20</StreamGeometry>

  <!-- Backlinks: arrows arriving at a point, which is what a backlink is. -->
  <StreamGeometry x:Key="IconBacklinks">M20 12 H8 M12 7 L7 12 L12 17 M4 5 V19</StreamGeometry>

  <!-- Mentions: a quotation, unclosed - a name said without a link. -->
  <StreamGeometry x:Key="IconMentions">M8 6 A5 5 0 0 0 8 16 M8 6 H11 A5 5 0 0 1 11 16 H8 M16 12 H20</StreamGeometry>

  <!-- Graph: three nodes and the edges between them. -->
  <StreamGeometry x:Key="IconGraph">M6 17 A2.5 2.5 0 1 0 6 16.9 Z M17 18 A2.5 2.5 0 1 0 17 17.9 Z M12 5 A2.5 2.5 0 1 0 12 4.9 Z M11 8 L7 14 M13 8 L16 14</StreamGeometry>

  <!-- Edit: a nib. -->
  <StreamGeometry x:Key="IconEdit">M4 20 L4.8 16 L16 4.8 A1.5 1.5 0 0 1 19.2 8 L8 19.2 Z M14 7 L17 10</StreamGeometry>

  <!-- Export: out of the page, not down to a disk - this writes files elsewhere. -->
  <StreamGeometry x:Key="IconExport">M12 15 V4 M8 8 L12 4 L16 8 M4 15 V19 A1 1 0 0 0 5 20 H19 A1 1 0 0 0 20 19 V15</StreamGeometry>

  <StreamGeometry x:Key="IconSave">M5 4 H16 L20 8 V19 A1 1 0 0 1 19 20 H5 A1 1 0 0 1 4 19 V5 A1 1 0 0 1 5 4 Z M8 4 V9 H15 M8 20 V14 H16 V20</StreamGeometry>
  <StreamGeometry x:Key="IconReload">M20 12 A8 8 0 1 1 17.6 6.4 M20 4 V10 H14</StreamGeometry>
  <StreamGeometry x:Key="IconOpen">M12 4 V14 M8 10 L12 14 L16 10 M4 16 V19 A1 1 0 0 0 5 20 H19 A1 1 0 0 0 20 19 V16</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M7 7 L17 17 M17 7 L7 17</StreamGeometry>
  <StreamGeometry x:Key="IconPalette">M4 7 H20 M4 12 H20 M4 17 H13</StreamGeometry>

  <!-- Theme: a disc half filled, the way a contrast control is always drawn. -->
  <StreamGeometry x:Key="IconTheme">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 3 A9 9 0 0 1 12 21 Z</StreamGeometry>

  <StreamGeometry x:Key="IconFit">M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15</StreamGeometry>

</ResourceDictionary>
