<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Detangle.App"
        x:Class="Detangle.App.MainWindow"
        x:DataType="app:ShellViewModel"
        x:CompileBindings="True"
        Title="Detangle"
        Width="1280"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <!--
    The window is a frame around the shell and nothing else. Everything is in ShellView so
    that the WASM demo, which has no windows at all, can host exactly the same control
    tree in a browser tab (plan.md section 8, phase 9).
  -->
  <app:ShellView />

</Window>
