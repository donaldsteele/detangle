<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Detangle.App"
        xmlns:vault="clr-namespace:Detangle.Core.Vault;assembly=Detangle.Core"
        x:Class="Detangle.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Detangle"
        Width="1100"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1" BorderBrush="#33808080">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBox Grid.Column="1" Name="VaultPathBox" Text="{Binding VaultPath}" PlaceholderText="Path to a vault" />
        <Button Grid.Column="2" Name="OpenButton" Content="Open" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="#33808080">
      <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75" />
    </Border>

    <Grid ColumnDefinitions="280,Auto,*">

      <ListBox Grid.Column="0"
               Name="DocumentList"
               ItemsSource="{Binding Documents}"
               SelectedItem="{Binding SelectedDocument}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vault:VaultDocument">
            <TextBlock Text="{Binding RelativePath}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

      <ScrollViewer Grid.Column="2" Name="DocumentScroller" Padding="28,20">
        <ContentControl Name="DocumentHost" MaxWidth="820" HorizontalAlignment="Left" />
      </ScrollViewer>

    </Grid>

  </DockPanel>

</Window>
