<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Detangle.App"
        xmlns:vault="clr-namespace:Detangle.Core.Vault;assembly=Detangle.Core"
        xmlns:graph="clr-namespace:Detangle.Core.Graph;assembly=Detangle.Core"
        xmlns:search="clr-namespace:Detangle.Core.Search;assembly=Detangle.Core"
        xmlns:diagnostics="clr-namespace:Detangle.Core.Diagnostics;assembly=Detangle.Core"
        xmlns:model="clr-namespace:Detangle.Rendering.Model;assembly=Detangle.Rendering"
        x:Class="Detangle.App.MainWindow"
        x:DataType="app:ShellViewModel"
        x:CompileBindings="True"
        Title="Detangle"
        Width="1280"
        Height="800"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock.rail-heading">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </Window.Styles>

  <Grid>
    <DockPanel>

      <!-- Toolbar: vault, history, theme, palette. -->
      <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#33808080">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <Button Grid.Column="0" Name="BackButton" Content="←" ToolTip.Tip="Back (Alt+Left)"
                  Command="{Binding GoBackCommand}" Margin="0,0,4,0" />
          <Button Grid.Column="1" Name="ForwardButton" Content="→" ToolTip.Tip="Forward (Alt+Right)"
                  Command="{Binding GoForwardCommand}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="2" Text="Detangle" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox Grid.Column="3" Name="VaultPathBox" Text="{Binding VaultPath}"
                   PlaceholderText="Path to a vault" />
          <Button Grid.Column="4" Name="OpenButton" Content="Open" Margin="8,0,0,0" />
          <Button Grid.Column="5" Content="◐" ToolTip.Tip="Toggle theme"
                  Command="{Binding ToggleThemeCommand}" Margin="6,0,0,0" />
        </Grid>
      </Border>

      <!-- Status bar: the section 5.5 counters. -->
      <Border DockPanel.Dock="Bottom" Padding="10,6" BorderThickness="0,1,0,0" BorderBrush="#33808080">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12" Opacity="0.75"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding LinkSummary}" FontSize="12" Opacity="0.75" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="270,Auto,*,Auto,300">

        <!-- Left rail: files, search, Link Doctor, tags. -->
        <TabControl Grid.Column="0" Name="LeftRail">
          <TabItem Header="Files">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="rail-heading" Margin="8,6,8,4"
                         Text="{Binding NavigationSourceName, StringFormat='FROM {0}'}" />
              <TreeView Name="NavigationTree" ItemsSource="{Binding Navigation}">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vault:NavigationNode" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
          </TabItem>

          <TabItem Header="Search">
            <DockPanel>
              <TextBox DockPanel.Dock="Top" Name="SearchBox" Text="{Binding SearchQuery}"
                       PlaceholderText="text, type:concept, tag:llm, path:wiki/, updated&gt;2026-06-01"
                       Margin="6" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding SearchSummary}" Classes="secondary"
                         Margin="8,0,8,6" />
              <ListBox Name="SearchList" ItemsSource="{Binding SearchResults}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="search:SearchHit">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Document.DisplayName}" FontSize="12" />
                      <TextBlock Text="{Binding Heading}" Classes="secondary" />
                      <TextBlock Text="{Binding Snippet}" Classes="secondary" TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Doctor">
            <DockPanel>
              <Button DockPanel.Dock="Top" Name="FixAllButton" Content="Fix all safe"
                      Margin="6" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Rewrites links that resolved by rules 4-8 to their canonical target" />
              <ListBox Name="FindingList" ItemsSource="{Binding Findings}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="diagnostics:Finding">
                    <StackPanel Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Severity}" Classes="secondary" />
                        <TextBlock Text="{Binding Kind}" FontSize="12" />
                      </StackPanel>
                      <TextBlock Text="{Binding Document.RelativePath}" Classes="secondary"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" MaxLines="3" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Tags">
            <TreeView Name="TagTree" ItemsSource="{Binding Tags}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="graph:TagNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Segment}" FontSize="12" />
                    <TextBlock Text="{Binding TotalCount}" Classes="secondary" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

        <!-- Center: tabs over the rendered document. -->
        <DockPanel Grid.Column="2">
          <ListBox DockPanel.Dock="Top" Name="TabStrip" ItemsSource="{Binding Tabs}"
                   SelectedItem="{Binding ActiveTab}" MaxHeight="40"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:DocumentTab">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Title}" FontSize="12" ToolTip.Tip="{Binding Path}" />
                  <Button Content="✕" FontSize="9" Padding="3,0" Background="Transparent"
                          BorderThickness="0" Click="OnCloseTabClick" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ScrollViewer Name="DocumentScroller" Padding="28,20">
            <ContentControl Name="DocumentHost" MaxWidth="860" HorizontalAlignment="Left" />
          </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" />

        <!-- Right rail: outline, backlinks, unlinked mentions. -->
        <TabControl Grid.Column="4" Name="RightRail">
          <TabItem Header="Outline">
            <ListBox Name="OutlineList" ItemsSource="{Binding Outline}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="model:HeadingRenderBlock">
                  <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis"
                             Margin="{Binding Level, Converter={x:Static app:LevelIndentConverter.Instance}}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>

          <TabItem Header="Backlinks">
            <ListBox Name="BacklinkList" ItemsSource="{Binding Backlinks}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="graph:Backlink">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Source.DisplayName}" FontSize="12" />
                    <TextBlock Classes="secondary" TextTrimming="CharacterEllipsis"
                               Text="{Binding Resolution.Rule, StringFormat='via {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>

          <TabItem Header="Mentions">
            <ListBox Name="MentionList" ItemsSource="{Binding Mentions}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="graph:UnlinkedMention">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Source.DisplayName}" FontSize="12" />
                    <TextBlock Text="{Binding Context}" Classes="secondary" TextWrapping="Wrap" MaxLines="2" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>

      </Grid>
    </DockPanel>

    <!-- Command palette, over everything. -->
    <Border Name="PaletteOverlay" IsVisible="{Binding IsPaletteOpen}"
            Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="#55808080"
              BorderThickness="1" CornerRadius="8" Width="600" MaxHeight="420"
              VerticalAlignment="Top" Margin="0,90,0,0" Padding="12">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" Name="PaletteBox" Text="{Binding PaletteQuery}"
                   PlaceholderText="Go to a page or heading…" Margin="0,0,0,8" />
          <ListBox Name="PaletteList" ItemsSource="{Binding PaletteResults}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:PaletteEntry">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Title}" FontSize="13" />
                  <TextBlock Text="{Binding Subtitle}" Classes="secondary" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

  </Grid>

</Window>
