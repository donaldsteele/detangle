<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Detangle.App"
             xmlns:vault="clr-namespace:Detangle.Core.Vault;assembly=Detangle.Core"
             xmlns:graph="clr-namespace:Detangle.Core.Graph;assembly=Detangle.Core"
             xmlns:linking="clr-namespace:Detangle.Core.Linking;assembly=Detangle.Core"
             xmlns:search="clr-namespace:Detangle.Core.Search;assembly=Detangle.Core"
             xmlns:diagnostics="clr-namespace:Detangle.Core.Diagnostics;assembly=Detangle.Core"
             xmlns:model="clr-namespace:Detangle.Rendering.Model;assembly=Detangle.Rendering"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="Detangle.App.ShellView"
             x:DataType="app:ShellViewModel"
             x:CompileBindings="True">

  <ThemeVariantScope Name="ThemeScope">
    <!-- The view paints its own background: a desktop window supplies one, and a browser
         tab does not, so without this the host page shows through. -->
    <Grid Background="{DynamicResource Shell}">
      <DockPanel>

        <!-- Toolbar. The vault path is the only field here, so it gets the room. -->
        <Border DockPanel.Dock="Top" Padding="10,9" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Line}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

            <Button Grid.Column="0" Name="BackButton" Classes="icon" ToolTip.Tip="Back (Alt+Left)"
                    Command="{Binding GoBackCommand}">
              <Path Data="{StaticResource IconBack}" />
            </Button>

            <Button Grid.Column="1" Name="ForwardButton" Classes="icon" ToolTip.Tip="Forward (Alt+Right)"
                    Command="{Binding GoForwardCommand}" Margin="0,0,8,0">
              <Path Data="{StaticResource IconForward}" />
            </Button>

            <!-- The runs sit on one line because XAML keeps the whitespace between them,
                 and "de tangle" is not the wordmark. -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="2,0,14,0"
                       FontSize="14" FontWeight="Bold" LetterSpacing="-0.02"><Run Text="de" Foreground="{DynamicResource Text}" /><Run Text="tangle" Foreground="{DynamicResource Accent}" /></TextBlock>

            <TextBox Grid.Column="3" Name="VaultPathBox" Text="{Binding VaultPath}"
                     PlaceholderText="Path to a folder of markdown" />

            <Button Grid.Column="4" Name="OpenButton" Classes="primary" Content="Open vault"
                    Margin="8,0,10,0" />

            <ToggleButton Grid.Column="5" Classes="icon" ToolTip.Tip="Navigation panel (Ctrl+B)"
                          IsChecked="{Binding IsLeftPanelVisible}" Padding="7">
              <Path Data="{StaticResource IconPanelLeft}" />
            </ToggleButton>

            <ToggleButton Grid.Column="6" Classes="icon" ToolTip.Tip="Outline panel (Ctrl+Shift+B)"
                          IsChecked="{Binding IsRightPanelVisible}" Padding="7" Margin="0,0,8,0">
              <Path Data="{StaticResource IconPanelRight}" />
            </ToggleButton>

            <ToggleButton Grid.Column="7" Classes="icon" ToolTip.Tip="Graph view (Ctrl+G)"
                          IsChecked="{Binding IsGraphVisible}" Padding="7">
              <Path Data="{StaticResource IconGraph}" />
            </ToggleButton>

            <ToggleButton Grid.Column="8" Classes="icon" ToolTip.Tip="Split editor (Ctrl+E)"
                          IsChecked="{Binding IsEditing}" Command="{Binding ToggleEditCommand}" Padding="7">
              <Path Data="{StaticResource IconEdit}" />
            </ToggleButton>

            <Button Grid.Column="9" Classes="icon" ToolTip.Tip="Export">
              <Path Data="{StaticResource IconExport}" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Name="ExportSiteItem" Header="Static site…"
                            ToolTip.Tip="One HTML file per page, with navigation and a prebuilt search index" />
                  <MenuItem Name="ExportSingleItem" Header="Single HTML file…" />
                  <MenuItem Name="ExportPageItem" Header="This page as HTML…" />
                  <MenuItem Name="ExportPdfItem" Header="PDF…" />
                  <Separator />
                  <MenuItem Name="NormalizeItem" Header="Normalize links in place"
                            ToolTip.Tip="Rewrites every link in the vault to its canonical target" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Grid.Column="10" Classes="icon" ToolTip.Tip="Command palette (Ctrl+K)"
                    Command="{Binding TogglePaletteCommand}">
              <Path Data="{StaticResource IconPalette}" />
            </Button>

            <Button Grid.Column="11" Classes="icon" ToolTip.Tip="Switch theme"
                    Command="{Binding ToggleThemeCommand}">
              <Path Data="{StaticResource IconTheme}" />
            </Button>
          </Grid>
        </Border>

        <!--
          The status bar has three slots and only three: the message on the left, one
          transient action in the middle, the vault's counters on the right. Anything that
          wants to say something goes in the left slot and nowhere else, which is what
          stops two unrelated things overwriting each other.
        -->
        <Border DockPanel.Dock="Bottom" Padding="12,7" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Line}" Background="{DynamicResource Panel}">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <!-- The message is the handle for the panel: one line here, all of it there. -->
            <Button Grid.Column="0" Classes="plain" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="0"
                    Command="{Binding ToggleStatusLogCommand}"
                    ToolTip.Tip="Show the last messages in full">
              <TextBlock Classes="identifier" Text="{Binding Status}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Button>

            <Button Grid.Column="1" Content="{Binding UpdateSummary}" IsVisible="{Binding HasUpdate}"
                    Command="{Binding InstallUpdateCommand}" FontSize="11" Padding="9,3" Margin="12,0"
                    ToolTip.Tip="Downloads the update and restarts into it" />
            <TextBlock Grid.Column="2" Classes="identifier" Text="{Binding LinkSummary}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <!--
          The status panel, opening upward out of the bar. Docked, so it takes room from
          the panes rather than covering them; monospace and selectable, so an exception
          can be read and quoted; and it never takes focus, because it is something to look
          at rather than something to use.
        -->
        <Border DockPanel.Dock="Bottom" Name="StatusPanel" IsVisible="{Binding IsStatusLogVisible}"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" MaxHeight="320">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,8,10,4">
              <TextBlock Grid.Column="0" Text="MESSAGES" Classes="label" VerticalAlignment="Center" />
              <Button Grid.Column="1" Name="CopyStatusLogButton" Content="Copy" FontSize="11"
                      Padding="9,3" ToolTip.Tip="Copies every message below" />
              <Button Grid.Column="2" Classes="icon" Margin="4,0,0,0"
                      Command="{Binding ToggleStatusLogCommand}" ToolTip.Tip="Close">
                <Path Data="{StaticResource IconClose}" Width="11" Height="11" />
              </Button>
            </Grid>

            <ScrollViewer Name="StatusLogScroller" Padding="12,0,12,10">
              <ItemsControl ItemsSource="{Binding StatusLog}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" Classes="identifier"
                                         TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!--
          Both rails collapse, and separately. The centre column is the reading pane and is
          the only star column, so the two Auto columns beside it fold to nothing when their
          rail is hidden - except the outline column, which carries a fixed width and needs
          the converter to give it up. The splitters go with their rail: a resize handle for
          a panel that is not there is a handle that resizes nothing.
        -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding IsRightPanelVisible, Converter={x:Static app:PanelColumnConverter.Instance}, ConverterParameter=300}" />
          </Grid.ColumnDefinitions>

          <!--
            The navigation rail. Four icons down the side rather than four text tabs
            across a narrow panel, which never fitted and wrapped onto two lines.
          -->
          <TabControl Grid.Column="0" Name="LeftRail" TabStripPlacement="Left"
                      IsVisible="{Binding IsLeftPanelVisible}"
                      Background="{DynamicResource Panel}" BorderThickness="0,0,1,0"
                      BorderBrush="{DynamicResource Line}" Width="294" MinWidth="150">

            <TabItem Classes="rail" ToolTip.Tip="Files">
              <TabItem.Header>
                <Path Data="{StaticResource IconFiles}" />
              </TabItem.Header>
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="label" Margin="14,14,14,8"
                           Text="{Binding NavigationSourceName, StringFormat='FROM {0}'}" />
                <TreeView Name="NavigationTree" ItemsSource="{Binding Navigation}">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vault:NavigationNode" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </TabItem>

            <TabItem Classes="rail" ToolTip.Tip="Search">
              <TabItem.Header>
                <Path Data="{StaticResource IconSearch}" />
              </TabItem.Header>
              <DockPanel>
                <TextBox DockPanel.Dock="Top" Name="SearchBox" Text="{Binding SearchQuery}"
                         PlaceholderText="text, type:concept, tag:llm, path:wiki/"
                         Margin="12,14,12,6" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SearchSummary}" Classes="label"
                           Margin="14,0,14,8" />
                <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap"
                           Margin="14,4,14,0"
                           Text="Words, or type:concept, tag:llm, path:wiki/, updated&gt;2026-06-01."
                           IsVisible="{Binding SearchQuery, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                <ListBox Name="SearchList" ItemsSource="{Binding SearchResults}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="search:SearchHit">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Document.DisplayName}" FontSize="12.5"
                                   Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Heading}" Classes="identifier"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Snippet}" Classes="secondary"
                                   TextWrapping="Wrap" MaxLines="2" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>

            <TabItem Classes="rail" ToolTip.Tip="Link Doctor">
              <TabItem.Header>
                <Path Data="{StaticResource IconDoctor}" />
              </TabItem.Header>
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,14,12,8" Spacing="6">
                  <Button Name="FixAllButton" Content="Fix all safe" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Rewrites links that resolved by rules 4-8 to their canonical target" />
                  <Button Name="ShowIgnoredButton" HorizontalAlignment="Stretch"
                          Content="{Binding IgnoredCount, StringFormat='Show {0} ignored'}"
                          IsVisible="{Binding IgnoredCount}"
                          ToolTip.Tip="Reports every finding you have dismissed in this vault again" />

                  <!--
                    Marking is explicit because nothing tells the application that a
                    generation run has finished; the watcher fires dozens of times while
                    one is under way (plan.md section 15.4).
                  -->
                  <Button Name="MarkBaselineButton" Content="Mark this state"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="Writes .detangle-baseline.json at the vault root, and measures every later change against the vault as it stands now. detangle-lint --mark writes the same file." />

                  <TextBlock Text="{Binding ChangeSummary}" Classes="secondary" TextWrapping="Wrap"
                             IsVisible="{Binding ChangeSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />

                  <CheckBox Name="OnlyChangedBox" Content="Since I last marked"
                            IsChecked="{Binding ShowOnlyChanged}"
                            IsVisible="{Binding ChangeSummary, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Shows only findings in pages that changed since the baseline" />

                  <!--
                    Rung fourteen is the only one a person writes, and it used to be
                    invisible from the moment it was made. Collapsed by default: this panel
                    is the densest surface in the application, and a list nobody has asked
                    for should not push the findings off the screen.
                  -->
                  <Expander Name="SettledExpander" Header="{Binding SettledSummary}"
                            IsVisible="{Binding HasSettledChoices}"
                            HorizontalAlignment="Stretch" Margin="0,2,0,0">
                    <ItemsControl ItemsSource="{Binding SettledChoices}" MaxHeight="220">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="linking:SettledChoice">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                            <StackPanel Grid.Column="0" Spacing="2">
                              <TextBlock Text="{Binding RawTarget}" FontSize="12.5"
                                         Foreground="{DynamicResource Text}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding TargetPath, StringFormat='means {0}'}"
                                         Classes="identifier" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="plain" Content="Revoke"
                                    Click="OnRevokeChoiceClick" VerticalAlignment="Center"
                                    ToolTip.Tip="Makes this link ambiguous again" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </StackPanel>

                <!--
                  The confirm card for a vault-wide rewrite. Docked in the same region as
                  the action card, not floated: this application has one overlay stratum
                  and the palette is it. Cancel comes first and is the default, because the
                  reader who clicked without reading meant to look, not to rewrite.
                -->
                <Border DockPanel.Dock="Bottom" Name="WriteConfirm"
                        IsVisible="{Binding PendingWrite, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Accent}"
                        BorderThickness="0,2,0,0" Padding="12,10">
                  <StackPanel Spacing="8" DataContext="{Binding PendingWrite}"
                              x:DataType="app:PendingWrite">
                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="{Binding Summary}" Classes="secondary" TextWrapping="Wrap" />

                    <!-- The whole set before any of it happens. Scrolled rather than
                         truncated: "and 94 more" is the part a reader needs to check. -->
                    <ScrollViewer MaxHeight="180">
                      <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="app:PendingWriteFile">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                              <TextBlock Grid.Column="0" Text="{Binding Path}" Classes="identifier"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="label"
                                         Margin="8,0,0,0" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Name="CancelWriteButton" Content="Cancel" IsDefault="True"
                              ToolTip.Tip="Nothing is written (Esc)" />
                      <Button Name="ConfirmWriteButton" Content="Rewrite"
                              ToolTip.Tip="Writes every file listed above" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!--
                  The action card. It is docked to the bottom rather than shown in a
                  dialog because triage is a rhythm: look, decide, next. A dialog puts a
                  click between every finding and the one after it.
                -->
                <Border DockPanel.Dock="Bottom" Name="FindingActions" IsVisible="False"
                        Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="0,1,0,0" Padding="12,10">
                  <StackPanel Spacing="8">
                    <TextBlock Name="FindingDetail" Classes="secondary" TextWrapping="Wrap" MaxLines="3" />

                    <!--
                      Wrapped rather than ellipsised: what changed is usually at the end of
                      the line, which is exactly the part a single line trims away, so the
                      preview would show everything except the point of it.
                    -->
                    <StackPanel Name="FindingDiff" Spacing="5" IsVisible="False">
                      <TextBlock Name="FindingBefore" Classes="identifier"
                                 TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      <TextBlock Name="FindingAfter" Classes="identifier"
                                 TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Name="ApplyFixButton" Content="Fix" IsVisible="False"
                              ToolTip.Tip="Rewrites this one link and saves the file" />
                      <Button Name="CreateNoteButton" Content="Create the note" IsVisible="False"
                              ToolTip.Tip="Writes the page this broken link was pointing at" />
                      <Button Name="IgnoreFindingButton" Content="Ignore"
                              ToolTip.Tip="Stops reporting this one; the file is not touched" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!--
                  A TreeView measures its items at unbounded width, so a wrapping message
                  inside one never wraps: it lays out on a single line and pushes a
                  horizontal scrollbar under the panel instead. Disabling that scrollbar is
                  what forces the available width back to the panel's, and stretching the
                  item content is what makes the row use it.
                -->
                <!--
                  The chip the ledger raises. It is the only thing that says the tree is
                  showing part of the vault rather than all of it, so it dismisses itself
                  rather than needing the reader to find where the filter came from.
                -->
                <Button DockPanel.Dock="Top" Name="ClearFindingFilterButton" Classes="plain"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="14,4,14,8"
                        IsVisible="{Binding FindingFilterSummary, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Show the whole vault again">
                  <TextBlock Text="{Binding FindingFilterSummary, StringFormat='{}{0}  ×'}"
                             Classes="label" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Accent}" />
                </Button>

                <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap"
                           Margin="14,4,14,0"
                           Text="Every link in this vault resolved, and nothing is orphaned or stale."
                           IsVisible="{Binding HasCleanBillOfHealth}" />

                <TreeView Name="FindingTree" ItemsSource="{Binding FindingGroups}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="app:FindingGroup" x:DataType="app:FindingGroup"
                                      ItemsSource="{Binding Findings}">
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,3">
                        <Border Width="3" Height="12" CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Severity, Converter={x:Static app:SeverityBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                   Foreground="{DynamicResource Text}" />
                      </StackPanel>
                    </TreeDataTemplate>
                    <DataTemplate DataType="diagnostics:Finding" x:DataType="diagnostics:Finding">
                      <StackPanel Spacing="2" Margin="0,3">
                        <TextBlock Text="{Binding Document.RelativePath}" FontSize="12.5"
                                   Foreground="{DynamicResource Text}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Message}" Classes="secondary"
                                   TextWrapping="Wrap" MaxLines="2" />
                      </StackPanel>
                    </DataTemplate>
                  </TreeView.DataTemplates>
                </TreeView>
              </DockPanel>
            </TabItem>

            <TabItem Classes="rail" ToolTip.Tip="Tags">
              <TabItem.Header>
                <Path Data="{StaticResource IconTags}" />
              </TabItem.Header>
              <!--
                The tree says a tag names fourteen pages; the list under it is those
                fourteen. Split rather than replaced, because picking a tag is a step
                towards a page and not away from the tag beside it.
              -->
              <Grid RowDefinitions="*,Auto,Auto">
                <TextBlock Grid.Row="0" Classes="secondary" TextWrapping="Wrap"
                           Margin="14,14,14,0" VerticalAlignment="Top"
                           Text="No page in this vault carries a tag, in its frontmatter or in its text."
                           IsVisible="{Binding !HasTags}" />

                <TreeView Grid.Row="0" Name="TagTree" ItemsSource="{Binding Tags}" Margin="0,10,0,0">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="graph:TagNode" ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Segment}" FontSize="12.5" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalCount}" Classes="label"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="1" ResizeDirection="Rows"
                              IsVisible="{Binding TagSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!--
                  Header and list share a row so the splitter has two things to resize.
                  With nothing selected the row measures to nothing and the tree has the
                  whole panel back.
                -->
                <DockPanel Grid.Row="2" Height="250" Background="{DynamicResource Panel}"
                           IsVisible="{Binding TagSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                  <!--
                    The header is the affordance: the tag's own name hands "tag:llm" to the
                    search box, which is the same question asked of the index rather than of
                    the tree. A separate button for that would be a button that repeats a
                    label already on screen.
                  -->
                  <Button DockPanel.Dock="Top" Name="TagSearchButton" Classes="plain"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Padding="14,10,14,6"
                          ToolTip.Tip="Search the vault for this tag">
                    <TextBlock Text="{Binding TagSummary}" Classes="label"
                               TextTrimming="CharacterEllipsis" />
                  </Button>

                  <ListBox Name="TagDocumentList" ItemsSource="{Binding TagDocuments}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vault:VaultDocument">
                        <StackPanel Spacing="3">
                          <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                     Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding RelativePath}" Classes="identifier"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Grid>
            </TabItem>
          </TabControl>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns" IsVisible="{Binding IsLeftPanelVisible}" />

          <!-- Centre: the document, or the graph over the whole vault. -->
          <Grid Grid.Column="2" Background="{DynamicResource Ink}">
            <DockPanel IsVisible="{Binding !IsGraphVisible}">

              <ListBox DockPanel.Dock="Top" Name="TabStrip" ItemsSource="{Binding Tabs}"
                       SelectedItem="{Binding ActiveTab}" Padding="6,6,6,0"
                       Background="{DynamicResource Shell}"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="app:DocumentTab">
                    <Grid ColumnDefinitions="Auto,Auto" ToolTip.Tip="{Binding Path}">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5"
                                 VerticalAlignment="Center" MaxWidth="180"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="icon" Padding="4" Margin="8,0,-4,0"
                              Click="OnCloseTabClick" ToolTip.Tip="Close">
                        <Path Data="{StaticResource IconClose}" Width="11" Height="11" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!--
                The link ledger: how this page's links resolved, in proportion, before a
                word of it has been read. The one place colour is allowed to shout.
              -->
              <app:LinkLedger DockPanel.Dock="Top" Name="Ledger" />

              <!--
                Find in page. Below the ledger, not above it: the ledger reads as welded to
                the tab strip, and a bar between them breaks the one graphic idea the centre
                pane has. Hidden until Ctrl+F, and it takes no room while it is.
              -->
              <Border DockPanel.Dock="Top" Name="FindBar" IsVisible="False"
                      Background="{DynamicResource Shell}" Padding="10,6"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                  <TextBox Grid.Column="0" Name="FindBox" PlaceholderText="Find in this page"
                           FontSize="12.5" Padding="8,4" />

                  <TextBlock Grid.Column="1" Name="FindSummary" Classes="identifier"
                             VerticalAlignment="Center" Margin="10,0" MinWidth="72" />

                  <Button Grid.Column="2" Name="FindPreviousButton" Classes="icon"
                          ToolTip.Tip="Previous match (Shift+Enter)">
                    <Path Data="{StaticResource IconBack}" />
                  </Button>

                  <Button Grid.Column="3" Name="FindNextButton" Classes="icon"
                          ToolTip.Tip="Next match (Enter)">
                    <Path Data="{StaticResource IconForward}" />
                  </Button>

                  <ToggleButton Grid.Column="4" Name="FindMatchCaseBox" Content="Aa"
                                Margin="6,0,0,0" Padding="8,3" FontSize="11"
                                ToolTip.Tip="Match case" />

                  <Button Grid.Column="5" Name="FindCloseButton" Classes="icon" Margin="4,0,0,0"
                          ToolTip.Tip="Close (Esc)">
                    <Path Data="{StaticResource IconClose}" Width="11" Height="11" />
                  </Button>
                </Grid>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding IsEditing, Converter={x:Static app:EditorColumnConverter.Instance}}" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" IsVisible="{Binding IsEditing}"
                           Background="{DynamicResource Shell}">
                  <Border DockPanel.Dock="Top" Padding="10,7" BorderThickness="0,0,0,1"
                          BorderBrush="{DynamicResource Line}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Name="SaveButton" Classes="icon" ToolTip.Tip="Save (Ctrl+S)">
                        <Path Data="{StaticResource IconSave}" />
                      </Button>
                      <Button Name="ReloadButton" Classes="icon"
                              ToolTip.Tip="Discard edits and reread the file">
                        <Path Data="{StaticResource IconReload}" />
                      </Button>
                      <TextBlock Text="Unsaved changes" Classes="label" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Accent}"
                                 IsVisible="{Binding HasUnsavedChanges}" />
                    </StackPanel>
                  </Border>
                  <Border Name="ConflictBanner" DockPanel.Dock="Top" IsVisible="False"
                          Background="{DynamicResource Raised}" Padding="12,9"
                          BorderThickness="0,0,0,2" BorderBrush="{DynamicResource Broken}">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="This file changed on disk since it was opened. Reload to take that version, or save again to keep yours." />
                  </Border>
                  <edit:TextEditor Name="Editor" ShowLineNumbers="True" WordWrap="True"
                                   Background="{DynamicResource Ink}"
                                   FontFamily="{DynamicResource IdentifierFont}" FontSize="13" />
                </DockPanel>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                              IsVisible="{Binding IsEditing}" />

                <ScrollViewer Grid.Column="2" Name="DocumentScroller"
                              IsVisible="{Binding HasVault}">
                  <!-- A reading measure, centred. Prose set the full width of a maximised
                       window is not prose anybody finishes. -->
                  <ContentControl Name="DocumentHost" MaxWidth="760" HorizontalAlignment="Center"
                                  Margin="40,32,40,80" />
                </ScrollViewer>

                <!--
                  First launch used to be three empty panes and one status line, with
                  nothing on screen saying what this is. The shell's own voice: the
                  wordmark, one sentence, and the folders you were reading last. No
                  illustration, no feature grid, no second filled button — the toolbar
                  already has the one that opens a vault.
                -->
                <ScrollViewer Grid.Column="2" Name="StartScreen" IsVisible="{Binding !HasVault}">
                  <StackPanel MaxWidth="520" HorizontalAlignment="Center" Margin="40,90,40,60"
                              Spacing="10">
                    <TextBlock FontSize="34" FontWeight="Bold" LetterSpacing="-0.02"><Run Text="de" Foreground="{DynamicResource Text}" /><Run Text="tangle" Foreground="{DynamicResource Accent}" /></TextBlock>

                    <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,18"
                               Text="Point it at a folder of markdown. Nothing is imported and nothing is converted — drop one here, or use Open vault above." />

                    <TextBlock Classes="label" Text="RECENT" IsVisible="{Binding HasRecentVaults}" />

                    <ItemsControl ItemsSource="{Binding RecentVaults}" IsVisible="{Binding HasRecentVaults}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RecentVault">
                          <Button Classes="plain" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" Padding="0,7"
                                  Click="OnRecentVaultClick" ToolTip.Tip="{Binding Path}">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding Name}" FontSize="13.5"
                                         Foreground="{DynamicResource Text}"
                                         TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Flavor}" Classes="label" />

                                <!-- A folder that has moved is marked, not dropped:
                                     silently losing it leaves a reader wondering whether
                                     they imagined opening it. -->
                                <TextBlock Text="MISSING" Classes="label"
                                           Foreground="{DynamicResource Faint}"
                                           IsVisible="{Binding !Exists}" />
                                <TextBlock Text="{Binding Path}" Classes="identifier"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </DockPanel>

            <!-- Graph view: filters above a canvas that draws the whole vault at once. -->
            <DockPanel IsVisible="{Binding IsGraphVisible}">
              <Border DockPanel.Dock="Top" Padding="12,9" BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource Line}" Background="{DynamicResource Shell}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding GraphTypeFilter}" PlaceholderText="type" Width="110" />
                    <TextBox Text="{Binding GraphTagFilter}" PlaceholderText="tag" Width="110" />
                    <TextBox Text="{Binding GraphFolderFilter}" PlaceholderText="folder" Width="150" />
                    <CheckBox Content="Orphans" IsChecked="{Binding GraphShowsOrphans}" />
                    <CheckBox Content="Missing" IsChecked="{Binding GraphShowsMissingTargets}" />
                    <CheckBox Content="Local" IsChecked="{Binding IsGraphLocal}"
                              ToolTip.Tip="Only pages within a few hops of the open one" />
                    <NumericUpDown Value="{Binding GraphHops}" Minimum="1" Maximum="6" Width="92"
                                   IsEnabled="{Binding IsGraphLocal}" FormatString="0" />
                    <Button Name="GraphFitButton" Classes="icon" ToolTip.Tip="Fit to view">
                      <Path Data="{StaticResource IconFit}" />
                    </Button>
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="{Binding GraphSummary}" Classes="label" />

                    <!-- The hover readout, beside the summary rather than in the status
                         bar: a mouse crossing the picture must not erase the shell's own
                         last message. -->
                    <TextBlock Grid.Column="1" Text="{Binding GraphHover}" Classes="identifier"
                               Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>
              </Border>
              <Panel Name="GraphHost" />
            </DockPanel>
          </Grid>

          <GridSplitter Grid.Column="3" ResizeDirection="Columns" IsVisible="{Binding IsRightPanelVisible}" />

          <!-- Right: what points at this page, and what it contains. -->
          <!-- A minimum so the splitter cannot crush the rail down to clipped initials. -->
          <TabControl Grid.Column="4" Name="RightRail" MinWidth="210" IsVisible="{Binding IsRightPanelVisible}"
                      Background="{DynamicResource Panel}"
                      BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Line}">

            <TabItem Header="Outline">
              <ListBox Name="OutlineList" ItemsSource="{Binding Outline}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="model:HeadingRenderBlock">
                    <TextBlock Text="{Binding Text}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Margin="{Binding Level, Converter={x:Static app:LevelIndentConverter.Instance}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>

            <TabItem Header="Backlinks">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap"
                           Margin="12,12,12,0"
                           Text="Nothing in this vault links to this page yet."
                           IsVisible="{Binding HasNoBacklinks}" />
                <ListBox Name="BacklinkList" ItemsSource="{Binding Backlinks}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="graph:Backlink">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Source.DisplayName}" FontSize="12.5"
                                 Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="identifier" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Resolution.Rule, StringFormat='via {0}'}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>

            <TabItem Header="Mentions">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="secondary" TextWrapping="Wrap"
                           Margin="12,12,12,0"
                           Text="No page names this one without linking to it."
                           IsVisible="{Binding HasNoMentions}" />
                <ListBox Name="MentionList" ItemsSource="{Binding Mentions}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="graph:UnlinkedMention">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Source.DisplayName}" FontSize="12.5"
                                 Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Context}" Classes="secondary"
                                 TextWrapping="Wrap" MaxLines="2" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </TabItem>
          </TabControl>

        </Grid>
      </DockPanel>

      <!--
        Drop feedback: an accent hairline inset on the window edge. Not a scrim and not a
        "drop here" panel — the palette is the only thing in this application allowed to
        float over the shell.
      -->
      <Border Name="DropTarget" IsVisible="False" IsHitTestVisible="False" Margin="3"
              BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="4" />

      <!-- Command palette, over everything. -->
      <Border Name="PaletteOverlay" IsVisible="{Binding IsPaletteOpen}" Background="#99000000">
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}"
                BorderThickness="1" CornerRadius="12" Width="620" MaxHeight="440"
                VerticalAlignment="Top" Margin="0,110,0,0" Padding="14"
                BoxShadow="0 24 60 -20 #cc000000">
          <DockPanel>
            <TextBox DockPanel.Dock="Top" Name="PaletteBox" Text="{Binding PaletteQuery}"
                     PlaceholderText="Go to a page, a heading, or an action…" Margin="0,0,0,10"
                     FontFamily="{DynamicResource UiFont}" FontSize="14" Padding="12,9" />
            <ListBox Name="PaletteList" ItemsSource="{Binding PaletteResults}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:PaletteEntry">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="13"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="{Binding Subtitle}" Classes="identifier" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Border>

    </Grid>
  </ThemeVariantScope>

</UserControl>
