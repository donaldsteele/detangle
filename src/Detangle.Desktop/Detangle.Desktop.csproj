<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Detangle.Desktop</RootNamespace>
    <AssemblyName>detangle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--
    Self-contained + trimmed + single-file, not Native AOT. Avalonia's XAML and
    binding layer is reflection-heavy and AOT failures are silent (blank windows).
    Revisit AOT once the dependency set is frozen. See plan.md section 11.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Detangle.App\Detangle.App.csproj" />
    <ProjectReference Include="..\Detangle.Rendering\Detangle.Rendering.csproj" />
  </ItemGroup>

</Project>
