<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Detangle.Desktop</RootNamespace>
    <AssemblyName>detangle</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--
    Self-contained + trimmed + single-file, not Native AOT. Avalonia's XAML and
    binding layer is reflection-heavy and AOT failures are silent (blank windows).
    Revisit AOT once the dependency set is frozen. See plan.md section 11.
  -->
  <!--
    Only when a runtime identifier has been chosen, which means publishing. Setting
    SelfContained at build time makes the SDK infer a RID from the host and then demand a
    restore target for it, which a solution-wide "dotnet restore" has not produced - so
    "dotnet build -c Release" failed on macOS and Linux while passing on the machine the
    project was written on.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>

    <!--
      The repository treats warnings as errors, and the trimmer reports one for every
      dependency that touches reflection. Two do: YamlDotNet, which deserializes
      frontmatter by reflecting over types, and Avalonia.DesignerSupport, which exists
      only for the XAML previewer. Both are handled below, so the remaining reports are
      informational and must not fail a release build. Individual warnings are still
      printed rather than rolled into one per assembly, so a new one is visible.
    -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!--
      YamlDotNet is kept whole. Trimming it away would not fail the build; it would make
      frontmatter parsing return empty objects at run time in the shipped app only, which
      is precisely the silent-failure mode plan.md section 11 rejects AOT for.
    -->
    <TrimmerRootAssembly Include="YamlDotNet" />
  </ItemGroup>

  <!--
    SkiaSharp and HarfBuzz ship native .pdb files, which are 111 MB next to a 63 MB
    application. They are debugging symbols for somebody else's native code and have no
    business in a release download; our own symbols are embedded in the executable.
  -->
  <Target Name="StripSymbolsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Detangle.App\Detangle.App.csproj" />
    <ProjectReference Include="..\Detangle.Rendering\Detangle.Rendering.csproj" />
  </ItemGroup>

</Project>
