<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Detangle.Rendering</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Mermaider" />
    <PackageReference Include="TextMateSharp" />
    <PackageReference Include="TextMateSharp.Grammars" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <!--
    Fonts are compiled in rather than looked up by name. The WebAssembly build has no
    system fonts to search, and the faces that ship with desktop systems are missing half
    the mathematical symbols a wiki uses - Segoe UI, Arial and Cascadia all draw an empty
    box for the transpose sign. See THIRD-PARTY-NOTICES.md for their licences.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- The CSS flattener is an implementation detail of diagram rendering, but its edge
       cases are exactly what wants testing directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Detangle.Rendering.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Detangle.Core\Detangle.Core.csproj" />
  </ItemGroup>

</Project>
