      belong next to the renderer's — a test project is never published, so referencing it
      here costs the demo nothing.
    -->
    <ProjectReference Include="..\..\src\Detangle.Highlighting\Detangle.Highlighting.csproj" />
  </ItemGroup>

</Project>
