reader.md
  properties yaml references=1
  h1 #reader-torture: Reader torture
  paragraph: Everything the reader has to draw, on one page.
  h2 #callouts-both-dialects: Callouts, both dialects
  callout obsidian/note: Note
    paragraph: An Obsidian callout with no title.
  callout obsidian/warning: Mind the gap
    paragraph: One with a title, and a [link ExactVaultPath -> case-drift.md] link inside it.
  callout obsidian/tip [closed]: Folded by default
    paragraph: Hidden until the reader opens it.
  callout mkdocs/note: Note
    paragraph: A MkDocs admonition.
  callout mkdocs/danger: Named admonition
    paragraph: With a title, a list:
    list items=2
      item
        paragraph: one
      item
        paragraph: two
  callout mkdocs/question [closed]: Collapsed admonition
    paragraph: Only visible once expanded.
  quote
    paragraph: Just an ordinary quotation, not a callout.
  h2 #tables: Tables
  table rows=3 columns=3
  h2 #code: Code
  code lang=csharp lines=2
  diagram mermaid source-only
  diagram dbml source-only tables=2
  diagram mermaid source-only
  code lang=- lines=1
  h2 #math: Math
  paragraph: Inline [math E = mc^2] inside a sentence.
  math: \int_0^1 x^2 \, dx = \frac{1}{3}
  h2 #lists: Lists
  list items=3
    item [unchecked]
      paragraph: an unchecked task
    item [checked]
      paragraph: a checked task
    item
      paragraph: a plain item
      list items=1
        item
          paragraph: a nested item
  ordered-list items=2
    item
      paragraph: three
    item
      paragraph: four
  h2 #definitions: Definitions
  definition-list items=1
    definition: Term
      paragraph: Its definition.
  h2 #footnotes: Footnotes
  paragraph: A claim that needs support [footnote evidence] .
  h2 #transclusion: Transclusion
  embed anchor-host.md
    h2 #duplicate: Duplicate
    paragraph: First.
  embed folder/index.md
    h1 #folder-index: Folder index
  embed (unresolved) error="nowhere-at-all" matches no file in this vault.
  h2 #attachments: Attachments
  paragraph: [image -> extension-probe.png]
  paragraph: [image -> extension-probe.png]
  h2 #emphasis: Emphasis
  paragraph: <bold>bold</> , <italic>italic</> , <strikethrough>struck</> , <highlight>highlighted</> , <superscript>super</> , <subscript>sub</> , `inline code` .
  footnotes: evidence

