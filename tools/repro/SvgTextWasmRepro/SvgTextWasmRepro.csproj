<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    A self-contained reproduction of the Svg.Skia typeface defect described in
    ../svg-null-typeface.md. It has no Avalonia and no Detangle in it: SkiaSharp, Svg.Skia,
    and a Main that prints a table. Everything it needs is stated here rather than
    inherited, so it can be copied out of this repository and run anywhere.

      dotnet publish tools/repro/SvgTextWasmRepro -c Release -o out
      # then serve out/wwwroot and read the browser console

    Swap the Svg.Skia PackageReference below for a ProjectReference to a source checkout to
    test an unreleased fix; both forms are here, one commented out.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.1" Condition="'$(SvgSkiaSource)' == ''" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.148.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.0" />
  </ItemGroup>

  <!--
    To test a source checkout instead of the released package, comment out the Svg.Skia
    PackageReference above and point these at it. Svg.Skia's own repository layout:
  -->
  <ItemGroup Condition="'$(SvgSkiaSource)' != ''">
    <ProjectReference Include="$(SvgSkiaSource)\src\Svg.Skia\Svg.Skia.csproj" />
    <ProjectReference Include="$(SvgSkiaSource)\src\Svg.Model\Svg.Model.csproj" />
    <ProjectReference Include="$(SvgSkiaSource)\src\Svg.Custom\Svg.Custom.csproj" />
  </ItemGroup>

</Project>
